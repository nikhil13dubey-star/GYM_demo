# Gym Habit - Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
# Hosted alternative:
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=gym_demo

# JWT Configuration (REQUIRED - generate a strong random string, minimum 32 characters)
JWT_SECRET_KEY=your-secret-key-minimum-32-characters

# Google Geocoding API (for location search feature)
GOOGLE_GEOCODING_API_KEY=your-google-api-key

# Environment (development | production)
ENVIRONMENT=production
